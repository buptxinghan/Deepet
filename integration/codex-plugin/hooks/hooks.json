{
  "description": "Advisory task status events for the local Deepet app",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/report.py\"",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
